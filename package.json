{
  "name": "hy-memory-omni",
  "version": "0.1.0",
  "private": true,
  "description": "Source-aware multimodal memory based on Tencent Hy-Memory, running on Workers",
  "author": "YY",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "bin": {
    "hy-memory-omni": "scripts/cli.mjs"
  },
  "scripts": {
    "init": "node scripts/cli.mjs init",
    "setup": "node scripts/cli.mjs setup",
    "start": "node scripts/cli.mjs start",
    "build": "node memory/build.mjs",
    "typecheck": "tsc --noEmit -p memory/tsconfig.json",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:memory": "node --test --test-concurrency=1 memory/test/*.test.mjs",
    "test:install": "node test/install-smoke.mjs",
    "inspect": "node scripts/cli.mjs inspect",
    "cloud": "node scripts/cli.mjs cloud",
    "test:live": "node test/live-acceptance.mjs"
  },
  "files": [
    "scripts/",
    "gateway/",
    "memory/src/",
    "memory/scripts/",
    "memory/codecs/",
    "memory/build.mjs",
    "memory/licenses/",
    "memory/wrangler.jsonc",
    "memory/worker-configuration.d.ts",
    "engine/src/",
    "engine/pyproject.toml",
    "engine/pylock.toml",
    "engine/wrangler.jsonc",
    "engine/UPSTREAM-LICENSE",
    "docs/",
    "config.example.json",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "memory/test/fixtures/README.md",
    "README.en.md",
    "AGENTS.md",
    "test/live-acceptance.mjs",
    "test/live-fixtures/",
    "memory/test/fixtures/tone.wav",
    "memory/test/fixtures/synthetic-meeting-m42.mp4",
    "npm-shrinkwrap.json",
    "test/live-image-grounding.mjs",
    "memory/documents/",
    "test/live-document-fixtures.mjs",
    "memory/test/document-fixtures.mjs",
    "test/live-document-grounding.mjs",
    "test/live-flac-grounding.mjs",
    "test/live-layout-grounding.mjs",
    "memory/fonts/",
    "memory/test/office-render-fixtures.mjs"
  ],
  "dependencies": {
    "@wasm-audio-decoders/flac": "0.2.11",
    "esbuild": "0.28.1",
    "fast-png": "8.0.0",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "mediabunny": "1.62.1",
    "miniflare": "5.20261012.0-beta",
    "mpg123-decoder": "1.0.3",
    "opus-decoder": "0.7.12",
    "pdf-lib": "1.17.1",
    "wrangler": "4.151.0",
    "reamkit": "1.33.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261014.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "undici": "7.30.1",
    "reamkit": {
      "fast-xml-parser": "$fast-xml-parser",
      "fflate": "$fflate"
    }
  }
}
